# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Artefakty weryfikacji (PDF->PNG)
/tmp/
scripts/_podglad/

# Robocze artefakty testow QA (PDF-y, JSON-y, zrzuty) - nie trafiaja do repo
scripts/_qa/
scripts/probne-*

# worker pdf.js — kopiowany z node_modules w predev/prebuild (zgodność wersji)
/public/pdfjs/
